# Application environment: development | production
ENV=development

# HTTP server
HTTP_ADDRESS=
HTTP_PORT=3000
HTTP_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Logger: level=debug|info|warn|error, format=json|text
LOG_LEVEL=debug
LOG_FORMAT=json

FIAS_BASE_URL=https://fias-public-service.nalog.ru
FIAS_MASTER_TOKEN=
