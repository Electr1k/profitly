# Application environment: development | production
ENV=development

# HTTP server
HTTP_ADDRESS=
HTTP_PORT=3000
HTTP_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Logger: level=debug|info|warn|error, format=json|text
LOG_LEVEL=debug
LOG_FORMAT=json

# Yandex Geocoder API (https://yandex.ru/maps-api/products/geocoder)
YANDEX_APIKEY=
YANDEX_BASE_URL=https://geocode-maps.yandex.ru/v1
YANDEX_LANG=ru_RU
YANDEX_TIMEOUT=5s
YANDEX_USE_STUB=true
